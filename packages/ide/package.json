{
  "name": "@megacrow/ide",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "predev": "npm run build:docs",
    "dev": "vite",
    "build": "vite build",
    "build:docs": "node ./scripts/copy-docs.mjs",
    "build:web": "npm run build:docs && vite build",
    "preview": "vite preview",
    "cli": "tsx --import ./scripts/megalo-src-register.mjs src/cli/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "icons": "tauri icon public/megacrow-icon.png",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "link:blf": "npm run build --prefix ../../../blf/blf-ts && npm link @blamnetwork/blf --workspace=@megacrow/ide"
  },
  "dependencies": {
    "@blamnetwork/blf": "^1.1.0-beta.17",
    "@megacrow/lsp": "*",
    "@megacrow/megalo": "*",
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "monaco-editor": "^0.55.1",
    "monaco-themes": "^0.4.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rosetta": "^1.1.0",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-languageserver-types": "^3.17.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.6"
  },
  "optionalDependencies": {
    "@tauri-apps/cli-darwin-arm64": "^2.11.2",
    "@tauri-apps/cli-darwin-x64": "^2.11.2",
    "@tauri-apps/cli-linux-arm64-gnu": "^2.11.2",
    "@tauri-apps/cli-linux-x64-gnu": "^2.11.2",
    "@tauri-apps/cli-win32-x64-msvc": "^2.11.2"
  }
}
